#!/bin/sh
# Team rule (CLAUDE.md hard rule 5b): commit messages never credit an AI tool.
# This hook stops a commit whose message has a "Co-Authored-By: Claude" style line or a
# "Generated with Claude Code" line, so no AI account can ever show up as a contributor.
# Turn it on once per laptop:  git config core.hooksPath .githooks

if grep -qiE '^co-authored-by:.*(claude|anthropic)|generated with .*claude|noreply@anthropic\.com' "$1"; then
  echo "Commit refused: the message credits an AI tool (Co-Authored-By Claude / Generated with Claude)." >&2
  echo "Remove that line and commit again." >&2
  exit 1
fi
exit 0
